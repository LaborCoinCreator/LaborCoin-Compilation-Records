		"devdoc": {
			"details": "This contract is deliberately deterministic and administrator-free. It rejects non-ASCII text, markup delimiters, obvious URL schemes, prohibited normalized tokens, prohibited two- and three-token phrases, punctuation-separated spellings, common numerical substitutions, and sequences composed of separated single letters. It is a lexical safeguard, not a semantic language model. No finite immutable denylist can recognize every hateful implication or every novel obfuscation. The exact policy and its limitations are publicly committed.",
			"kind": "dev",
			"methods": {
				"validateDescription(string)": {
					"returns": {
						"contentHash": "Keccak-256 of the exact accepted description bytes."
					}
				}
			},
			"title": "LaborCoin Proposal Text Policy V1",
			"version": 1
		},
