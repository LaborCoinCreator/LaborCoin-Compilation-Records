		"devdoc": {
			"details": "This contract is deliberately deterministic and administrator-free. Short proposal labels are limited to single-line printable ASCII, reject markup and URL markers, and are screened against the committed hashed lexical denylist using the same normalization and obfuscation defenses as the original policy candidate. Verification references are validated separately and may use only the exact `https://` or `ipfs://` schemes. IPFS references are restricted to a canonical CID root: CIDv0 base58btc (`Qm...`) or CIDv1 base32/base36 (`b...` / `k...`) before any path, query, or fragment. It is a lexical and structural safeguard, not a semantic language model. No finite immutable denylist can recognize every hateful implication or every novel obfuscation. External verification content is not and cannot be authenticated or moderated by this contract.",
			"kind": "dev",
			"methods": {
				"validateOrganizationName(string)": {
					"returns": {
						"contentHash": "Keccak-256 of the exact accepted field bytes."
					}
				},
				"validateVerificationURI(string)": {
					"returns": {
						"contentHash": "Keccak-256 of the exact accepted URI bytes."
					}
				},
				"validateWorkerGroupOrCampaign(string)": {
					"returns": {
						"contentHash": "Keccak-256 of the exact accepted field bytes."
					}
				}
			},
			"title": "LaborCoin Proposal Text Policy V1",
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"isOrganizationNameAllowed(string)": {
					"notice": "Non-reverting organization-name preview for wallets and frontends."
				},
				"isVerificationURIAllowed(string)": {
					"notice": "Non-reverting verification-URI preview for wallets and frontends."
				},
				"isWorkerGroupOrCampaignAllowed(string)": {
					"notice": "Non-reverting worker-group/campaign preview for wallets and frontends."
				},
				"validateOrganizationName(string)": {
					"notice": "Reverts unless `organizationName` satisfies the permanent short-text policy."
				},
				"validateVerificationURI(string)": {
					"notice": "Reverts unless `verificationURI` satisfies the permanent URI policy."
				},
				"validateWorkerGroupOrCampaign(string)": {
					"notice": "Reverts unless `workerGroupOrCampaign` satisfies the permanent short-text policy."
				}
			},
			"notice": "Immutable validation policy for human-authored fields in structured LaborCoin treasury proposals.",
			"version": 1
		}
